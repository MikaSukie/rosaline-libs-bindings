// Complete Raylib bindings for Rosaline (formerly Lucile)
// Compile & link with: -lraylib -lm -ldl -lpthread (Linux)
//                      -lraylib -framework... (macOS)
//                      raylib.lib (Windows)
// ============================================================
// Structs
// ============================================================

struct Vector2 {
    f32 x;
    f32 y;
}

struct Vector3 {
    f32 x;
    f32 y;
    f32 z;
}

struct Vector4 {
    f32 x;
    f32 y;
    f32 z;
    f32 w;
}

struct Rectangle {
    f32 x;
    f32 y;
    f32 width;
    f32 height;
}

packed struct Color {
    u8 r;
    u8 g;
    u8 b;
    u8 a;
}

struct Texture {
    u32 id;
    i32 width;
    i32 height;
    i32 mipmaps;
    i32 format;
}

struct RenderTexture {
    u32     id;
    Texture texture;
    Texture depth;
}

struct Image {
    void* data;
    i32   width;
    i32   height;
    i32   mipmaps;
    i32   format;
}

struct Font {
    i32     baseSize;
    i32     glyphCount;
    i32     glyphPadding;
    Texture texture;
    void*   recs;
    void*   glyphs;
}

struct Camera2D {
    Vector2 offset;
    Vector2 target;
    f32     rotation;
    f32     zoom;
}

struct Camera3D {
    Vector3 position;
    Vector3 target;
    Vector3 up;
    f32     fovy;
    i32     projection;
}

struct Ray {
    Vector3 position;
    Vector3 direction;
}

struct BoundingBox {
    Vector3 min;
    Vector3 max;
}

struct NPatchInfo {
    Rectangle source;
    i32       left;
    i32       top;
    i32       right;
    i32       bottom;
    i32       layout;
}

struct AudioStream {
    void* buffer;
    void* processor;
    u32   sampleRate;
    u32   sampleSize;
    u32   channels;
}

struct FilePathList {
    u32  capacity;
    u32  count;
    str* paths;
}

struct Wave {
    u32   frameCount;
    u32   sampleRate;
    u32   sampleSize;
    u32   channels;
    void* data;
}

struct Sound {
    AudioStream stream;
    u32         frameCount;
}

struct Music {
    AudioStream stream;
    u32         frameCount;
    bool        looping;
    i32         ctxType;
    void*       ctxData;
}

